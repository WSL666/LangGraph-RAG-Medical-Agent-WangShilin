# =====================================================================
# LLM / Embedding API (OpenAI 兼容)
# =====================================================================
# 推荐使用硅基流动 / 阿里百炼 / 自建 vLLM 等 OpenAI 兼容服务
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# Embedding 模型（用于稠密向量检索）
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=4
EMBEDDING_TEXT_MAX_CHARS=3000

# =====================================================================
# Elasticsearch
# =====================================================================
ES_HOST=127.0.0.1
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=your_es_password
ES_INDEX_NAME=medical_articles
ES_EMBEDDING_FIELD=embedding

# =====================================================================
# RAG 检索参数
# =====================================================================
# 默认检索模式：hybrid / bm25 / embedding / weighted
RAG_RETRIEVAL_MODE=hybrid
RAG_TOP_K=3
RAG_CANDIDATE_SIZE=9
RAG_HYBRID_ALPHA=0.5
# RRF 融合参数
RAG_RRF_K=60
RAG_RRF_W_BM25=1.0
RAG_RRF_W_EMB=1.0

# =====================================================================
# Redis 缓存
# =====================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =====================================================================
# Gradio Web UI
# =====================================================================
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7939
